<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
  ExtensionBundleId="com.textframeinspector.plugin"
  ExtensionBundleName="TextFrameInspector"
  ExtensionBundleVersion="1.1.0"
  Version="7.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.textframeinspector.plugin.panel" Version="1.1.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[24.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="5.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.textframeinspector.plugin.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine />
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Text Frame Inspector</Menu>
          <Geometry>
            <Size>
              <Height>760</Height>
              <Width>360</Width>
            </Size>
            <MinSize>
              <Height>520</Height>
              <Width>300</Width>
            </MinSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
